# Recommended to keep for local development
RUST_LOG=colibri_appview=debug,rocket=info

# Database URL to the local PostgreSQL DB
DATABASE_URL=postgres://...
# Maximum concurrent connections from AppView to database
DATABASE_MAX_CONNECTIONS=40

# Hostname & Port for Tap
TAP_HOSTNAME=127.0.0.1:2480
# Tap password
TAP_ADMIN_PASSWORD=...
# How many workers are used to process Tap events
TAP_WORKERS=16

# How often (in seconds) the AppView reports whether Tap is still backfilling
# repos: one line when backfilling starts, one per interval while it is ongoing,
# and one when it concludes. Silent while every repo is caught up. Defaults to
# 30. Set to 0 to disable.
BACKFILL_REPORT_SECS=30

# Self-heal knob. If set to any non-empty value, the AppView clears its local
# record_data cache at boot, then removes and re-adds every DID it has ever
# recorded anything about with Tap so Tap redoes a full historical backfill
# for each (a plain re-add is a no-op for repos Tap already tracks). Use this
# to recover an AppView whose cache has drifted due to a past bug.
REFILL_FROM_SCRATCH=

# Private key used for cryptographic proof in ATproto ops
K256_PRIVATE_KEY=...

# The PDS newly created communities live on. REQUIRED: every community gets its
# own repo, hosted on this PDS. `docker-compose.pds.yml` runs a reference one in
# production; `docker-compose.pds.dev.yml` runs a local one for development, in
# which case this is http://localhost:3000.
PDS_LOC=https://pds.example.com
# Admin password for the PDS. Used both by the AppView (to create community
# accounts) and by the PDS compose files (as the PDS's own admin password).
PDS_ADMIN_PASS=...

# Optional operator secret. When set, mounts POST /admin/recover-credentials?did=…
# (HTTP basic auth as `admin:<this>`), which forces credential recovery for one
# community instead of waiting for the next write to trigger it. Left unset, the
# route is not mounted at all.
#   curl -u admin:$APPVIEW_ADMIN_PASS -X POST \
#     'http://localhost:8000/admin/recover-credentials?did=did:plc:...'
APPVIEW_ADMIN_PASS=

# The domain that communities get their handles from. (Handles will be example.${APPVIEW_HANDLE_DOMAIN})
# A wildcard record for *.${APPVIEW_HANDLE_DOMAIN} must point at the PDS, since
# the PDS answers handle resolution for the communities it hosts. Locally, `test`
# is a good choice: reserved, and nothing has to resolve.
APPVIEW_HANDLE_DOMAIN=example.com

# Only read by the PDS compose files, never by the AppView itself.

# Public hostname of that PDS. Ends up in every community DID document, so it
# must be reachable over HTTPS from the outside. Usually the host part of PDS_LOC.
# The dev compose file defaults this to `localhost`.
PDS_HOSTNAME=pds.example.com
# Secret the PDS signs its own session tokens with.
# Generate with: openssl rand --hex 16
PDS_JWT_SECRET=...
# The PDS's did:plc rotation key. Losing this means losing the ability to update
# the DID documents of every account on it, so back it up.
# Generate with:
#   openssl ecparam --name secp256k1 --genkey --noout --outform DER \
#     | tail -c +8 | head -c 32 | xxd -p -c 32
PDS_PLC_ROTATION_KEY=...
# The PLC directory the PDS registers community DIDs with. Defaults to
# https://plc.directory in production, and to the local PLC server in
# docker-compose.pds.dev.yml so test communities stay off the public directory.
PDS_DID_PLC_URL=
# Address the PDS's HTTP port is published on. Defaults to 127.0.0.1, i.e. only
# reachable by a reverse proxy on the same host. Set 0.0.0.0 if your proxy runs
# elsewhere. (The dev compose file always binds loopback.)
PDS_BIND_ADDR=127.0.0.1
# Host ports the PDS and the local dev PLC are published on.
PDS_HOST_PORT=3000
PLC_HOST_PORT=2582

# The did:web this AppView identifies as. Self-hosters MUST set this to their own
# identity. Defaults to did:web:api.colibri.social.
APPVIEW_DID=did:web:api.colibri.social

# Key used to encrypt app passwords issued for communities
CREDENTIAL_ENCRYPTION_KEY=...

# API Key for KLIPY, optional. Get one from https://partner.klipy.com/, if unset, GIFs won't work.
KLIPY_API_KEY=...

# Push notification keys. When self-hosting, the public key must match that of the self-hosted client. Optional.
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
# Push notification subject email
VAPID_SUBJECT=mailto:example@example.com

# Voice SFU (mediasoup). All optional. The SFU is built and enabled by default.
# Number of mediasoup workers. Defaults to the number of CPU cores.
SFU_WORKER_COUNT=
# IP the SFU binds its WebRTC media sockets to. Defaults to 0.0.0.0.
SFU_LISTEN_IP=0.0.0.0
# Public IP announced in ICE candidates. REQUIRED behind NAT (e.g. most cloud
# hosts) so clients can reach the media ports; set it to the server's public IP.
SFU_ANNOUNCED_IP=
# UDP media port range. If both are set, open this range on your firewall and
# forward it to the container. If unset, mediasoup picks ephemeral ports.
SFU_RTC_MIN_PORT=40000
SFU_RTC_MAX_PORT=40100

# STUN/TURN servers handed to clients for ICE, as a JSON array of RTCIceServer
# objects. A TURN server is what lets clients on restrictive/symmetric-NAT
# networks (and some browsers) connect when a direct path to the media ports
# fails. Unset means no ICE servers (direct connection only). Example:
# SFU_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]
SFU_ICE_SERVERS=

# Required for native Android notifications, optional.
FCM_SERVICE_ACCOUNT_JSON=
